---
import "@/styles/html-post.css";
import { render } from "astro:content";

import BlogPagination from "@/components/blog/blog-pagination";
import { BlogTags } from "@/components/blog/blog-tags";
import { Comments } from "@/components/blog/comments";
import SocialShare from "@/components/blog/social-share";
import Base from "@/layouts/Base.astro";
import { getAdjacentPosts, getPostEntry, getPosts } from "@/lib/blogs";
import { FALLBACK_OG, SITE } from "@/lib/site";

export async function getStaticPaths() {
  return getPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { prevPost, nextPost } = getAdjacentPosts(post.slug);
const { Content } = await render(getPostEntry(post.slug));
const image = post.coverImage || FALLBACK_OG;
const date = post.created_at.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base
  title={`${post.title} | Avisek Ray Blog`}
  description={post.excerpt}
  image={image}
  type="article"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    image,
    datePublished: post.created_at.toISOString(),
    dateModified: post.updated_at.toISOString(),
    keywords: post.tags.join(", "),
    author: { "@type": "Person", name: "Avisek Ray", url: SITE },
    mainEntityOfPage: `${SITE}/blog/${post.slug}`,
  }}
>
  <div class="min-h-screen text-blog-fg">
    <div
      class="mx-auto post-theme box-border max-w-216 px-6 pt-16 pb-28 sm:pt-24 md:px-6 md:pt-24 md:pb-28"
    >
      <a
        href="/blog"
        id="back-to-blogs"
        class="text-(--post-accent) hover:underline mb-12 block text-[0.95rem]"
      >
        ← Back to All Blogs
      </a>
      <article>
        <header class="mb-8">
          <div class="mb-5 text-[0.95rem] leading-[1.8] text-(--post-muted)">{date}</div>
          <h1
            class="font-serif font-normal leading-[1.15] tracking-[-0.015em] text-(--post-text) text-[clamp(2.1rem,6vw,2.8rem)]"
          >
            {post.title}
          </h1>
        </header>
        <div class="relative wrap-break-words max-w-none text-blog-fg">
          <div class="html-post"><Content /></div>
          <BlogTags tags={post.tags} className="my-8" />
        </div>
        {post.excerpt && <SocialShare title={post.title} excerpt={post.excerpt} client:visible />}
        <BlogPagination prevPost={prevPost} nextPost={nextPost} />
        <Comments client:visible />
      </article>
    </div>
  </div>
  <script is:inline>
    // Came from the blog list: go back so the browser restores its scroll position.
    document.getElementById("back-to-blogs")?.addEventListener("click", (e) => {
      try {
        const ref = new URL(document.referrer);
        const fromList = ref.origin === location.origin && ref.pathname.replace(/\/$/, "") === "/blog";
        if (fromList && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch {}
    });
  </script>
</Base>
